{
  "expo": {
    "name": "Happy Hour",
    "slug": "happy-hour",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.happyhour.gamezone"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070B06",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.happyhour.gamezone"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070B06",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "happyhour",
    "backgroundColor": "#070B06",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://pjmizuqxdwvpkkszxfav.supabase.co",
      "supabasePublishableKey": "sb_publishable_scNp9T7TVrUcIsiSz-BYKA_kZgdHnXb"
    }
  }
}
